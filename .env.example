# Neon pooled URL (set by the Vercel Neon integration)
DATABASE_URL=
# Better Auth: signs sessions (openssl rand -base64 32) and the app's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000   # in production: the https URL
# Who may create an account (comma-separated)
ALLOWED_EMAILS=
# AI feedback (optional): on Vercel the OIDC token is used; locally `vercel env pull` adds
# VERCEL_OIDC_TOKEN, or set an AI Gateway key
# AI_GATEWAY_API_KEY=
