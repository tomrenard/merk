{
  "name": "merk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:backup && node --env-file=.env.local --experimental-strip-types scripts/migrate.ts",
    "import:words": "pnpm db:backup && node --env-file=.env.local --experimental-strip-types scripts/import-words.ts",
    "db:backup": "node --env-file=.env.local --experimental-strip-types scripts/backup.ts",
    "claim": "pnpm db:backup && node --env-file=.env.local --experimental-strip-types scripts/claim.ts",
    "units:index": "node --experimental-strip-types scripts/units-index.ts && biome check --write src/lib/units-index.ts"
  },
  "dependencies": {
    "ai": "^7.0.137",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "zod": "^4.6.5"
  }
}
